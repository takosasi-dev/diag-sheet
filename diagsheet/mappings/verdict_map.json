      {"field": "severity", "match": "exact", "raw": "ok", "label": "正常", "verdict": "ok"}
    ],
    "netdiag": [
      {"field": "jitter.quality", "match": "first_char", "raw": "優", "label": null, "verdict": "ok"},
      {"field": "jitter.quality", "match": "first_char", "raw": "良", "label": null, "verdict": "ok"},
      {"field": "jitter.quality", "match": "first_char", "raw": "可", "label": null, "verdict": "warn"},
      {"field": "jitter.quality", "match": "first_char", "raw": "不", "label": null, "verdict": "bad"},
      {"field": "dnsbl.has_problem", "match": "exact", "raw": true, "label": "問題あり", "verdict": "bad"},
      {"field": "dnsbl.has_problem", "match": "exact", "raw": false, "label": "問題なし", "verdict": "ok"}
    ]
  }
